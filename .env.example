# RyderTech — environment variables (copy to .env, fill values)
# NEVER commit .env. Secrets below are server-only unless prefixed PUBLIC_.

# Supabase (native auth + course purchases)
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
SUPABASE_ACCESS_TOKEN=sbp_xxx

# Paystack (NGN course checkout -> local bank)
PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_xxx
PAYSTACK_SECRET_KEY=sk_live_xxx

# EmailJS (lead capture, browser-only)
PUBLIC_EMAILJS_SERVICE_ID=service_xxx
PUBLIC_EMAILJS_TEMPLATE_ID=template_xxx
PUBLIC_EMAILJS_PUBLIC_KEY=xxx

# Gemini (live AI demo widget)
GOOGLE_GEMINI_API_KEY=xxx

# Booking
PUBLIC_BOOKING_URL=https://cal.com/xxx
